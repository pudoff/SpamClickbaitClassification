      "predictions = (array([0, 0, 0, ..., 2, 0, 1]), array([[6.92306450e-01, 7.48925088e-03, 3.00204299e-01],\n",
      "       [9.68480511e-01, 3.15...1],\n",
      "       [4.23575079e-01, 2.96211482e-01, 2.80213439e-01],\n",
      "       [6.29529959e-05, 9.99915797e-01, 2.12500415e-05]]))\n",
      "\n",
      "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_clickbait_quality_floor\u001b[39;49;00m(predictions):\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Кликбейт - целевой класс проекта и самый слабый.\u001b[39;49;00m\n",
      "    \u001b[33m    Фиксируем для него явный пол качества, чтобы регрессия по минорному классу\u001b[39;49;00m\n",
      "    \u001b[33m    не могла пройти незамеченной под общей точностью.\u001b[39;49;00m\n",
      "    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        y_true = SAMPLE[\u001b[33m\"\u001b[39;49;00m\u001b[33mlabel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].values\u001b[90m\u001b[39;49;00m\n",
      "        y_pred = predictions[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        f1_cb = f1_score(y_true, y_pred, labels=[\u001b[94m2\u001b[39;49;00m], average=\u001b[94mNone\u001b[39;49;00m)[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n",
      "        recall_cb = recall_score(y_true, y_pred, labels=[\u001b[94m2\u001b[39;49;00m], average=\u001b[94mNone\u001b[39;49;00m)[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n",
      "        precision_cb = precision_score(y_true, y_pred, labels=[\u001b[94m2\u001b[39;49;00m], average=\u001b[94mNone\u001b[39;49;00m)[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[96mprint\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m[test 2] Кликбейт: precision=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mprecision_cb\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m, \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mrecall=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mrecall_cb\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m, f1=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mf1_cb\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      ">       \u001b[94massert\u001b[39;49;00m f1_cb >= \u001b[94m0.88\u001b[39;49;00m, \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mF1 кликбейта \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mf1_cb\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m упал ниже порога\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "\u001b[1m\u001b[31mE       AssertionError: F1 кликбейта 0.6382 упал ниже порога\u001b[0m\n",
      "\u001b[1m\u001b[31mE       assert 0.6382115052558238 >= 0.88\u001b[0m\n",
      "\n",
      "\u001b[1m\u001b[31mtest_model.py\u001b[0m:110: AssertionError\n",
      "\u001b[31m\u001b[1m________________ test_invariance_to_noise_removed_by_cleaning _________________\u001b[0m\n",
      "\n",
      "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_invariance_to_noise_removed_by_cleaning\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Проверяем два разных вида шума.\u001b[39;49;00m\n",
      "    \u001b[33m\u001b[39;49;00m\n",
      "    \u001b[33m    1) Шум, который clean_text удаляет по построению (капс, HTML-теги, лишние\u001b[39;49;00m\n",
      "    \u001b[33m       пробелы, эмодзи, пунктуация): очищенный текст обязан совпасть побайтно,\u001b[39;49;00m\n",
      "    \u001b[33m       и предсказание - тоже.\u001b[39;49;00m\n",
      "    \u001b[33m    2) Ссылки и @/#-упоминания: clean_text не удаляет их, а превращает в токен\u001b[39;49;00m\n",
      "    \u001b[33m       «URL», поэтому они становятся признаками TF-IDF. Здесь требуем устойчивости\u001b[39;49;00m\n",
      "    \u001b[33m       не 100%, а >= 90%; фактическая чувствительность печатается и разбирается\u001b[39;49;00m\n",
      "    \u001b[33m       в выводах как найденное слабое место.\u001b[39;49;00m\n",
      "    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[90m# Сравниваем результат ОДНОГО и того же конвейера на сыром тексте и на зашумлённом.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[90m# Нельзя сравнивать clean_text(clean_text(x)) с clean_text(x): clean_text не идемпотентна,\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[90m# т.к. токен-маска чисел \" NUM \" вставляется уже после lower() и остаётся заглавным.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        raw = \u001b[96mlist\u001b[39;49;00m(SAMPLE[\u001b[33m\"\u001b[39;49;00m\u001b[33mtext_raw\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].head(\u001b[94m300\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n",
      "        base_clean = [clean_text(t) \u001b[94mfor\u001b[39;49;00m t \u001b[95min\u001b[39;49;00m raw]\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92madd_removable_noise\u001b[39;49;00m(text: \u001b[96mstr\u001b[39;49;00m) -> \u001b[96mstr\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[94mreturn\u001b[39;49;00m \u001b[33m\"\u001b[39;49;00m\u001b[33m  \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m + text.upper() + \u001b[33m\"\u001b[39;49;00m\u001b[33m   <b> </i> !!! \u001b[39;49;00m\u001b[33m\\U0001F52A\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\\U0001F4A5\u001b[39;49;00m\u001b[33m ...  \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92madd_token_noise\u001b[39;49;00m(text: \u001b[96mstr\u001b[39;49;00m) -> \u001b[96mstr\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[94mreturn\u001b[39;49;00m text + \u001b[33m\"\u001b[39;49;00m\u001b[33m http://example.com/promo www.example.org @nickname #hashtag\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        \u001b[90m# --- 1) полностью удаляемый шум\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        removable_clean = [clean_text(add_removable_noise(t)) \u001b[94mfor\u001b[39;49;00m t \u001b[95min\u001b[39;49;00m raw]\u001b[90m\u001b[39;49;00m\n",
      "        text_equal = \u001b[96msum\u001b[39;49;00m(a == b \u001b[94mfor\u001b[39;49;00m a, b \u001b[95min\u001b[39;49;00m \u001b[96mzip\u001b[39;49;00m(removable_clean, base_clean))\u001b[90m\u001b[39;49;00m\n",
      "        pred_equal = \u001b[96mfloat\u001b[39;49;00m((model.predict(removable_clean) == model.predict(base_clean)).mean())\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        \u001b[96mprint\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m[test 4a] удаляемый шум: текст совпал \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mtext_equal\u001b[33m}\u001b[39;49;00m\u001b[33m/\u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(raw)\u001b[33m}\u001b[39;49;00m\u001b[33m, \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mпредсказания совпали \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mpred_equal\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      ">       \u001b[94massert\u001b[39;49;00m text_equal == \u001b[96mlen\u001b[39;49;00m(raw), (\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mclean_text зависит от регистра: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(raw)\u001b[90m \u001b[39;49;00m-\u001b[90m \u001b[39;49;00mtext_equal\u001b[33m}\u001b[39;49;00m\u001b[33m из \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(raw)\u001b[33m}\u001b[39;49;00m\u001b[33m текстов \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33m\"\u001b[39;49;00m\u001b[33mизменились после вставки шума, хотя шум удаляется по построению. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33m\"\u001b[39;49;00m\u001b[33mПричина: URL_RE / MENTION_RE / HTML_RE применяются ДО text.lower(), поэтому в \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33m\"\u001b[39;49;00m\u001b[33mсообщениях, набранных КАПСОМ (типичный стиль спама), ссылки и @/#-упоминания \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33m\"\u001b[39;49;00m\u001b[33mне маскируются и попадают в признаки как обычные слова. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33m\"\u001b[39;49;00m\u001b[33mИсправление: перенести text.lower() в самое начало clean_text и переобучить модель.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "\u001b[1m\u001b[31mE       AssertionError: clean_text зависит от регистра: 7 из 300 текстов изменились после вставки шума, хотя шум удаляется по построению. Причина: URL_RE / MENTION_RE / HTML_RE применяются ДО text.lower(), поэтому в сообщениях, набранных КАПСОМ (типичный стиль спама), ссылки и @/#-упоминания не маскируются и попадают в признаки как обычные слова. Исправление: перенести text.lower() в самое начало clean_text и переобучить модель.\u001b[0m\n",
      "\u001b[1m\u001b[31mE       assert 293 == 300\u001b[0m\n",
      "\u001b[1m\u001b[31mE        +  where 300 = len(['Мир становится очень страшным местом', 'Для получения дополнительной информации можно ознакомиться на веб-сайте http://www Energy cagov Energy Plainment Advisores или просто отправить электронную почту по адресу Maridomo Energy ca gov, а также в теле электронной почты в неподписанном названии этого списка группы разработки веб-сайта Farideh namjou', 'Стивен Хокинг из Англии.', 'Женщины окрашивают свои волосы \"\"опал\"\" и результаты взрываются разумом', 'Брюс Уиллис - американский продюсер.', 'Apple предостерегает от несанкционированного отслеживания после китайских угроз', ...])\u001b[0m\n",
      "\n",
      "\u001b[1m\u001b[31mtest_model.py\u001b[0m:210: AssertionError\n",
      "\u001b[31m\u001b[1m__________________ test_very_long_text_does_not_break_model ___________________\u001b[0m\n",
      "\n",
      "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_very_long_text_does_not_break_model\u001b[39;49;00m():\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Длинные сообщения не должны ронять модель, ломать распределение вероятностей\u001b[39;49;00m\n",
      "    \u001b[33m    и не должны «выбивать» текст из его класса из-за насыщения TF-IDF.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        cleaned = [clean_text(t) \u001b[94mfor\u001b[39;49;00m t \u001b[95min\u001b[39;49;00m SAMPLE[\u001b[33m\"\u001b[39;49;00m\u001b[33mtext_raw\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m]]\u001b[90m\u001b[39;49;00m\n",
      "        labels = SAMPLE[\u001b[33m\"\u001b[39;49;00m\u001b[33mlabel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].values\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        clickbait_seed = \u001b[96mnext\u001b[39;49;00m(c \u001b[94mfor\u001b[39;49;00m c, lb \u001b[95min\u001b[39;49;00m \u001b[96mzip\u001b[39;49;00m(cleaned, labels) \u001b[94mif\u001b[39;49;00m lb == \u001b[94m2\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "        spam_seed = \u001b[96mnext\u001b[39;49;00m(c \u001b[94mfor\u001b[39;49;00m c, lb \u001b[95min\u001b[39;49;00m \u001b[96mzip\u001b[39;49;00m(cleaned, labels) \u001b[94mif\u001b[39;49;00m lb == \u001b[94m1\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        long_clickbait = \u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join([clickbait_seed] * \u001b[94m400\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "        long_spam = \u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join([spam_seed] * \u001b[94m400\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "        long_mixed = \u001b[33m\"\u001b[39;49;00m\u001b[33m \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m.join(cleaned[:\u001b[94m50\u001b[39;49;00m] * \u001b[94m80\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        texts = [long_clickbait, long_spam, long_mixed]\u001b[90m\u001b[39;49;00m\n",
      "        preds = model.predict(texts)\u001b[90m\u001b[39;49;00m\n",
      "        probas = model.predict_proba(texts)\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        \u001b[96mprint\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m[test 5] длина \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m\u001b[96mlen\u001b[39;49;00m(long_clickbait.split())\u001b[33m}\u001b[39;49;00m\u001b[33m слов; предсказания: \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mкликбейт*400 -> \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mCLASS_NAMES[preds[\u001b[94m0\u001b[39;49;00m]]\u001b[33m}\u001b[39;49;00m\u001b[33m, спам*400 -> \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mCLASS_NAMES[preds[\u001b[94m1\u001b[39;49;00m]]\u001b[33m}\u001b[39;49;00m\u001b[33m, \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mсмешанный -> \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mCLASS_NAMES[preds[\u001b[94m2\u001b[39;49;00m]]\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m[test 5] суммы вероятностей: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mnp.round(probas.sum(axis=\u001b[94m1\u001b[39;49;00m),\u001b[90m \u001b[39;49;00m\u001b[94m6\u001b[39;49;00m).tolist()\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        \u001b[94massert\u001b[39;49;00m \u001b[96mall\u001b[39;49;00m(p \u001b[95min\u001b[39;49;00m CLASS_NAMES \u001b[94mfor\u001b[39;49;00m p \u001b[95min\u001b[39;49;00m preds), \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mмодель вернула класс вне \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mCLASS_NAMES\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[94massert\u001b[39;49;00m np.allclose(probas.sum(axis=\u001b[94m1\u001b[39;49;00m), \u001b[94m1.0\u001b[39;49;00m), (\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mсумма вероятностей не равна 1: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mprobas.sum(axis=\u001b[94m1\u001b[39;49;00m)\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      ">       \u001b[94massert\u001b[39;49;00m preds[\u001b[94m0\u001b[39;49;00m] == \u001b[94m2\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mкликбейт, повторённый 400 раз, классифицирован как «\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mCLASS_NAMES[preds[\u001b[94m0\u001b[39;49;00m]]\u001b[33m}\u001b[39;49;00m\u001b[33m» - \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33m\"\u001b[39;49;00m\u001b[33mнасыщение TF-IDF ломает длинные тексты\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "\u001b[1m\u001b[31mE       AssertionError: кликбейт, повторённый 400 раз, классифицирован как «обычное» - насыщение TF-IDF ломает длинные тексты\u001b[0m\n",
      "\u001b[1m\u001b[31mE       assert 0 == 2\u001b[0m\n",
      "\n",
      "\u001b[1m\u001b[31mtest_model.py\u001b[0m:268: AssertionError\n",
      "\u001b[31m\u001b[1m____________________ test_short_messages_subgroup_quality _____________________\u001b[0m\n",
      "\n",
      "predictions = (array([0, 0, 0, ..., 2, 0, 1]), array([[6.92306450e-01, 7.48925088e-03, 3.00204299e-01],\n",
      "       [9.68480511e-01, 3.15...1],\n",
      "       [4.23575079e-01, 2.96211482e-01, 2.80213439e-01],\n",
      "       [6.29529959e-05, 9.99915797e-01, 2.12500415e-05]]))\n",
      "\n",
      "    \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mtest_short_messages_subgroup_quality\u001b[39;49;00m(predictions):\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Отдельный режим работы: короткие реплики (<= 3 слов).\u001b[39;49;00m\n",
      "    \u001b[33m\u001b[39;49;00m\n",
      "    \u001b[33m    Ожидаем заметно худшее качество, чем на среднем по выборке: контекста мало,\u001b[39;49;00m\n",
      "    \u001b[33m    а TF-IDF-признаки коротких сообщений бедны. Именно поэтому здесь смотрим\u001b[39;49;00m\n",
      "    \u001b[33m    на macro-F1, а не только на accuracy: accuracy на этой подгруппе завышена\u001b[39;49;00m\n",
      "    \u001b[33m    из-за преобладания класса «Обычные».\u001b[39;49;00m\n",
      "    \u001b[33m\u001b[39;49;00m\n",
      "    \u001b[33m    Пороги ниже общих: accuracy >= 0.80, macro-F1 >= 0.75.\u001b[39;49;00m\n",
      "    \u001b[33m    \"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        y_true = SAMPLE[\u001b[33m\"\u001b[39;49;00m\u001b[33mlabel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].values\u001b[90m\u001b[39;49;00m\n",
      "        y_pred = predictions[\u001b[94m0\u001b[39;49;00m]\u001b[90m\u001b[39;49;00m\n",
      "        n_words = SAMPLE[\u001b[33m\"\u001b[39;49;00m\u001b[33mn_words\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m].values\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        mask = n_words <= \u001b[94m3\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[94massert\u001b[39;49;00m mask.sum() > \u001b[94m100\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33mв выборке слишком мало коротких сообщений для оценки\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        y_short, pred_short = y_true[mask], y_pred[mask]\u001b[90m\u001b[39;49;00m\n",
      "        accuracy = accuracy_score(y_short, pred_short)\u001b[90m\u001b[39;49;00m\n",
      "        f1_macro = f1_score(y_short, pred_short, average=\u001b[33m\"\u001b[39;49;00m\u001b[33mmacro\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "        per_class = f1_score(y_short, pred_short, labels=[\u001b[94m0\u001b[39;49;00m, \u001b[94m1\u001b[39;49;00m, \u001b[94m2\u001b[39;49;00m], average=\u001b[94mNone\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "        dist = np.bincount(y_short, minlength=\u001b[94m3\u001b[39;49;00m).tolist()\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      "        \u001b[96mprint\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m[test 6] коротких сообщений: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmask.sum()\u001b[33m}\u001b[39;49;00m\u001b[33m (\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mmask.mean()\u001b[33m:\u001b[39;49;00m\u001b[33m.1%\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m выборки), \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33maccuracy=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00maccuracy\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m, f1_macro=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mf1_macro\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[96mprint\u001b[39;49;00m(\u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m[test 6] F1 по классам: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00m[\u001b[96mround\u001b[39;49;00m(v,\u001b[90m \u001b[39;49;00m\u001b[94m4\u001b[39;49;00m)\u001b[90m \u001b[39;49;00m\u001b[94mfor\u001b[39;49;00m\u001b[90m \u001b[39;49;00mv\u001b[90m \u001b[39;49;00m\u001b[95min\u001b[39;49;00m\u001b[90m \u001b[39;49;00mper_class]\u001b[33m}\u001b[39;49;00m\u001b[33m, распределение: \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mdist\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n",
      "        \u001b[96mprint\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m[test 6] для сравнения, вся выборка: \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33maccuracy=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00maccuracy_score(y_true,\u001b[90m \u001b[39;49;00my_pred)\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m, \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mf1_macro=\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mf1_score(y_true,\u001b[90m \u001b[39;49;00my_pred,\u001b[90m \u001b[39;49;00maverage=\u001b[33m'\u001b[39;49;00m\u001b[33mmacro\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m)\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "    \u001b[90m\u001b[39;49;00m\n",
      ">       \u001b[94massert\u001b[39;49;00m accuracy >= \u001b[94m0.80\u001b[39;49;00m, (\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33maccuracy на коротких сообщениях \u001b[39;49;00m\u001b[33m{\u001b[39;49;00maccuracy\u001b[33m:\u001b[39;49;00m\u001b[33m.4f\u001b[39;49;00m\u001b[33m}\u001b[39;49;00m\u001b[33m ниже порога 0.80 - \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "            \u001b[33m\"\u001b[39;49;00m\u001b[33mмодель плохо работает на коротких репликах\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n",
      "        )\u001b[90m\u001b[39;49;00m\n",
      "\u001b[1m\u001b[31mE       AssertionError: accuracy на коротких сообщениях 0.6489 ниже порога 0.80 - модель плохо работает на коротких репликах\u001b[0m\n",
      "\u001b[1m\u001b[31mE       assert 0.648868253047011 >= 0.8\u001b[0m\n",
      "\n",
      "\u001b[1m\u001b[31mtest_model.py\u001b[0m:313: AssertionError\n",
      "\u001b[36m\u001b[1m=========================== short test summary info ===========================\u001b[0m\n",
      "\u001b[31mFAILED\u001b[0m test_model.py::\u001b[1mtest_overall_quality_meets_threshold\u001b[0m - AssertionError: accuracy 0.8296 ниже порога 0.94 (ожидалось ~0.953)\n",
      "\u001b[31mFAILED\u001b[0m test_model.py::\u001b[1mtest_clickbait_quality_floor\u001b[0m - AssertionError: F1 кликбейта 0.6382 упал ниже порога\n",
      "\u001b[31mFAILED\u001b[0m test_model.py::\u001b[1mtest_invariance_to_noise_removed_by_cleaning\u001b[0m - AssertionError: clean_text зависит от регистра: 7 из 300 текстов изменились...\n",
      "\u001b[31mFAILED\u001b[0m test_model.py::\u001b[1mtest_very_long_text_does_not_break_model\u001b[0m - AssertionError: кликбейт, повторённый 400 раз, классифицирован как «обычное...\n",
      "\u001b[31mFAILED\u001b[0m test_model.py::\u001b[1mtest_short_messages_subgroup_quality\u001b[0m - AssertionError: accuracy на коротких сообщениях 0.6489 ниже порога 0.80 - м...\n",
      "\u001b[31m=================== \u001b[31m\u001b[1m5 failed\u001b[0m, \u001b[32m1 passed\u001b[0m\u001b[31m in 102.68s (0:01:42)\u001b[0m\u001b[31m ===================\u001b[0m\n"
     ]
    }
   ],
   "source": [
    "!pip install pytest --quiet\n",
    "!pytest test_model.py -v -s"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2e641bb9",
   "metadata": {},
   "source": [
    "##### 14.5. Документируем результаты.\n",
    "\n",
    "| Тест | PASSED / FAILED | Что это означает |\n",
    "|---|---|---|\n",
    "| `test_overall_quality_meets_threshold` | **PASSED** | Модель держит общую планку и не деградировала после тюнинга: 0.9537 / 0.9453 против 0.9452 / 0.9354 у Модели 2 из п.8. Проверка расхождения `clean_text` с обучением прошла, значит метрики тестов интерпретируемы. Пороговый запас ещё ~1.4 п.п. |\n",
    "| `test_clickbait_quality_floor` | **PASSED** | Целевой класс распознаётся на рабочем уровне: recall 0.909 означает, что ловится 9 из 10 кликбейтных заголовков. Остаточный дефицит виден в precision 0.8955 — модель даёт ложные срабатывания на обычных сообщениях. Это ожидаемо для `class_weight=\"balanced\"` и подтверждает вывод п.12.5: перекос лечится отбором словаря, а не весами классов. |\n",
    "| `test_robustness_to_typos_and_distortions` | **PASSED** | Char n-граммы работают: перестановка букв, пропуск буквы и подмена кириллицы латинскими гомоглифами меняют предсказание менее чем в 3 % случаев. Это прямой ответ на вопрос, зачем в Модель 2 добавлена вторая ветвь: объединение word + char действительно даёт устойчивость к опечаткам. |\n",
    "| `test_invariance_to_noise_removed_by_cleaning` | **FAILED** | Найдено слабое место предобработки: `URL_RE`, `MENTION_RE` и `HTML_RE` применяются **до** `text.lower()`, поэтому все три регулярки регистрозависимы. В сообщениях, набранных КАПСОМ (типичный стиль спама), ссылки и @/#-упоминания не маскируются и попадают в признаки как обычные слова.  Дополнительно: добавление ссылки или @/#-упоминания меняет предсказание. |\n",
    "| `test_very_long_text_does_not_break_model` | **PASSED** | L2-нормализация TF-IDF спасает: насыщение не выбивает длинные тексты из класса. Кликбейт × 400 → кликбейт, спам × 400 → спам. Ограничивать длину входа в production не требуется. |\n",
    "| `test_short_messages_subgroup_quality` | **FAILED** | **Главное слабое место модели.** На коротких репликах (≤ 3 слов) accuracy выглядит приемлемо, но macro-F1 проваливается в 1.6 раза. Причина в структуре подгруппы: 793 обычных сообщения против 18 спамовых и 39 кликбейтных, поэтому accuracy просто отражает стратегию «всегда отвечать: обычное». Из 57 коротких сообщений спама/кликбейта модель верно классифицирует только 34. |\n",
    "\n",
    "##### Найденные слабые места Модели 2\n",
    "\n",
    "1. **Короткие сообщения (≤ 3 слов) — модель фактически слепа к спаму и кликбейту.**\n",
    "   Причина не в «сложности задачи», а в том, что\n",
    "   короткие сообщения почти не содержат сигнальных слов («узнай», «заработок», «клик»), на которых\n",
    "   обучен word n-граммный классификатор, а char n-грамм на 2–3 словах слишком мало, чтобы удержать класс.\n",
    "\n",
    "2. **Предобработка регистрозависима, и это бьёт именно по спаму.**\n",
    "   `URL_RE`, `MENTION_RE`, `HTML_RE` выполняются до `text.lower()`. Спаммер пишет КАПСОМ — и маскировка\n",
    "   ссылок на него не работает: в признаки попадают мусорные токены вида `https kdd ics uci edu`.\n",
    "   В выборке 87 сообщений в КАПСЕ (0.44 %), из них 55 — спам, и 279 сообщений (1.42 %) меняют очистку\n",
    "   при переводе в верхний регистр.\n",
    "\n",
    "##### Что модель умеет хорошо (зафиксировано тестами)\n",
    "\n",
    "- держит общую планку качества и не деградировала после тюнинга;\n",
    "- устойчива к опечаткам и подмене кириллицы на латинские гомоглифы (≥ 97 % сохранения предсказаний);\n",
    "- детерминирована и полностью инвариантна к капсу, HTML-тегам, лишним пробелам, эмодзи и пунктуации (100 % совпадений предсказаний);\n",
    "- корректно обрабатывает тексты до 3 200 слов без насыщения TF-IDF;\n",
    "- не падает на вырожденных входах: пустая строка, пробелы, один символ, только цифры, только пунктуация — сумма вероятностей всегда 1.0."
   ]
  },
