# Скопируйте в .env (он в .gitignore) и при необходимости поменяйте значения.

# Порт Swagger UI / API на хосте (слушает только 127.0.0.1)
API_PORT=8000

# Ансамбль — каталог с manifest.json; model.joblib/model.pkl поддерживаются явно для LR.
MODEL_FILE=ensemble/manifest.json

# Политика решения (02-final-concept.md §6): уверенность ниже порога -> status=uncertain
TAU=0.55
TAU_SPAM=0.65

# Обучение: baseline | exp1 | exp2 | exp3 | exp4 | exp5 (см. inference-api/training/train.py)
TRAIN_CONFIG=exp4
MODEL_VERSION=1
