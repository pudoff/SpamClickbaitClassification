<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Retraining" targetNamespace="https://github.com/pudoff/SpamClickbaitClassification/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:error id="OperationError" name="Ошибка операции" errorCode="OPERATION_FAILED" />
  <bpmn:process id="Retraining" name="Retraining и согласование выпуска" isExecutable="false">
    <bpmn:documentation>Проект процесса, не установленная автоматизация. Метрики/пороги триггеров и ворот требуют утверждения команды. Независимый release-eval замораживается до сравнения.</bpmn:documentation>
    <bpmn:laneSet id="Roles">
      <bpmn:lane id="Lane_ops" name="Backend / MLOps">
        <bpmn:flowNodeRef>Drift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Incident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Deploy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Smoke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Healthy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoRelease</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retain</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LogNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndNotify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NotifyError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RollbackError</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DeployError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pm" name="Вы: PM / QA">
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ValidationOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReleaseOK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Recovery</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ml" name="ML-инженер">
        <bpmn:flowNodeRef>Train</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tune</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Auction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Winner</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TrainingError</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_data" name="Данные / ASR">
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataOK</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Drift" name="Сигнал дрейфа / ухудшения метрик ниже порога">
      <bpmn:documentation>Условное стартовое событие. Предлагаемый триггер: PSI &gt; 0.20 в двух окнах с N ≥ 500; дрейф не доказывает ухудшение качества и не означает автоматический выпуск.</bpmn:documentation>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="DriftCondition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">drift_alert == true</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Incident" name="Запуск процесса переобучение и фиксация текущей версию модели">
      <bpmn:documentation>Создать run_id; сохранить версии champion, кода, данных и политики. Проверить cooldown и отсутствие другого активного цикла. Решение и параметры мониторинга журналируются.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Prepare" name="Собрать и версионировать новые данные">
      <bpmn:documentation>С согласия собрать новые примеры. Отдельно сохранить временное окно и источник. Применить фиксированные правила очистки, убрать межчастные точные и близкие дубликаты. TTS допускается только в fit.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Label" name="Проверить разметку и заморозить сплиты">
      <bpmn:documentation>Ручная разметка и разрешение конфликтов. Зафиксировать fit/dev/release-eval по группам. Все три класса присутствуют; release-eval не участвует в обучении, выборе весов и порогов. Результат: dataset_version и quality_report.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="DataOK" name="Данные пригодны?" default="Flow_19">
      <bpmn:documentation>Проверены схема, разрешение использования, разметка, достаточность и отсутствие межчастных пересечений. Нет — оставить champion и уведомить о необходимости доработки данных.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Train" name="Переобучить кандидатов на fit">
      <bpmn:documentation>Обучить LR, RNN и CNN только на fit; словари и любые обучаемые преобразования также только на fit. Сохранить checkpoint, конфигурацию, seed и dataset_version. Ошибка обучения перехватывается граничным Error Event.</bpmn:documentation>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Tune" name="Выбрать чекпойнты и веса на dev">
      <bpmn:documentation>Выбрать checkpoint и веса ансамбля по dev macro-F1, откалибровать/зафиксировать политику на выделенных данных. Заморозить candidate_bundle и Model Card до обращения к release-eval.</bpmn:documentation>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Validate" name="Валидировать кандидата вручную">
      <bpmn:documentation>User Task PM/QA: code review, проверка разметки/сплитов, Model Card, dev-метрик, срезов и воспроизводимости. Записать approve/reject, комментарий, автора и время. Тестовые результаты не используются для новой настройки кандидата.</bpmn:documentation>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ValidationOK" name="Валидация принята?" default="Flow_21">
      <bpmn:documentation>Да — допустить зафиксированного кандидата к независимому сравнению. Нет — сохранить текущую модель; замечания учитываются в следующем цикле.</bpmn:documentation>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Auction" name="Сравнить candidate и champion по AUC">
      <bpmn:documentation>Обе модели получают один и тот же свежий замороженный release-eval. Рассчитать ROC-AUC macro OVR по вероятностям классов 0/1/2, macro-F1, P/R по классам, срезы и задержку. Сохранить comparison_report и дополнить Model Card измеренными метриками. Это аукцион по AUC из задания.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Winner" name="AUC лучше и ворота пройдены?" default="Flow_22">
      <bpmn:documentation>Предлагаемое правило: AUC_candidate &gt; AUC_champion + 0.005; macro-F1 не хуже более чем на 0.005, precision spam — более чем на 0.01; просадка среза ≤ 0.05; технические/ресурсные тесты пройдены. Пороги согласуются заранее. При равенстве оставить champion.</bpmn:documentation>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Release" name="Согласовать выпуск версии">
      <bpmn:documentation>Второй human-in-the-loop: PM/QA рассматривает comparison_report, актуальную Model Card, риски и план отката; согласует с командой. Явно записать release_approved. Даже выигрыш AUC сам по себе не разрешает деплой.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ReleaseOK" name="Выпуск разрешён?" default="Flow_23">
      <bpmn:documentation>Да — подготовить переключение. Нет — текущая версия остаётся действующей, отказ и причина журналируются.</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Deploy" name="Развернуть новую версию">
      <bpmn:documentation>Сохранить previous и пакет модели/окружения/политики. Проверить SHA-256 компонентов, установить согласованный bundle; переключить конфигурацию inference-api. Автодеплой — проектируемая возможность, сейчас запуск ручной.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Smoke" name="Проверить health и smoke-тесты">
      <bpmn:documentation>Проверить /healthcheck, /model-info и контрольные /predict: версия, классы, суммы вероятностей, ожидаемые ответы и доступность. Для голоса добавить отдельные ASR/E2E-тесты после реализации конвейера.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Healthy" name="Проверки пройдены?" default="Flow_26">
      <bpmn:documentation>Да — зафиксировать outcome=deployed и новую действующую версию. Нет — откатить весь предыдущий комплект, а не только один checkpoint.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="NoRelease" name="Отказ от выпуска">
      <bpmn:documentation>Слияние альтернативных отказов. Это XOR-merge, он не ждёт токены одновременно от всех входящих веток.</bpmn:documentation>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Retain" name="Сохранить champion и причину отказа">
      <bpmn:documentation>outcome=kept. Причины: data_invalid, training_failed, validation_rejected, not_better или release_rejected. Сохранить отчёты и замечания; новый цикл начинается с нового согласованного сигнала.</bpmn:documentation>
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Rollback" name="Восстановить previous и проверить API">
      <bpmn:documentation>Восстановить предыдущие bundle, образ и политику; проверить health и контрольные ответы. Успех: outcome=rolled_back. Ошибка отката передаётся PM/QA как инцидент ручного восстановления.</bpmn:documentation>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Recovery" name="Организовать ручное восстановление">
      <bpmn:documentation>PM/QA и backend разбирают инцидент, восстанавливают сервис либо временно отключают выдачу решений. outcome=manual_recovery или unavailable. Доступность не объявляется без проверки.</bpmn:documentation>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Outcome" name="Итог цикла">
      <bpmn:documentation>XOR-слияние: deployed / kept / rolled_back / manual_recovery / unavailable. Текущая действующая версия указывается явно.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Notify" name="Уведомить команду в Telegram">
      <bpmn:documentation>Send Task: отправить PM/команде run_id, outcome, старую/текущую версии, метрики сравнения, если оно проводилось, причину отказа/отката и ссылку на Model Card. Если цикл остановлен до сравнения, указать «метрики не рассчитывались». Не пересылать исходные тексты и аудио. Здесь уведомления только спроектированы, не отправляются.</bpmn:documentation>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="LogNotify" name="Записать сбой доставки и инцидент">
      <bpmn:documentation>Сохранить notification_failed в журнале; предусмотреть ручную проверку/повтор. Журнал не содержит токенов доступа и пользовательского контента.</bpmn:documentation>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End" name="Цикл закрыт">
      <bpmn:documentation>Решение и доставка уведомления сохранены; мониторинг продолжает работать. Новый подтверждённый сигнал создаёт новый экземпляр процесса.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndNotify" name="Сбой уведомления учтён">
      <bpmn:documentation>Цикл закрыт с отдельной отметкой недоставленного уведомления; статус действующей модели остаётся тем, который реально подтверждён.</bpmn:documentation>
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="NotifyError" name="Ошибка уведомления" attachedToRef="Notify">
      <bpmn:documentation>После ограниченного числа повторов доставки сохранить ошибку отдельно. Успешный деплой не откатывается только из-за сбоя Telegram.</bpmn:documentation>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:errorEventDefinition id="NotifyErrorDefinition" errorRef="OperationError" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="RollbackError" name="Ошибка отката" attachedToRef="Rollback">
      <bpmn:documentation>Откат не подтверждён. Нельзя писать, что previous восстановлен; требуется ручное вмешательство.</bpmn:documentation>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:errorEventDefinition id="RollbackErrorDefinition" errorRef="OperationError" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="DeployError" name="Ошибка деплоя" attachedToRef="Deploy">
      <bpmn:documentation>Граничное прерывающее событие ошибки: перейти к откату независимо от успешности HTTP healthcheck.</bpmn:documentation>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:errorEventDefinition id="DeployErrorDefinition" errorRef="OperationError" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="TrainingError" name="Ошибка обучения" attachedToRef="Train">
      <bpmn:documentation>Прервать неуспешное обучение, записать причину. Champion не изменяется.</bpmn:documentation>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:errorEventDefinition id="TrainingErrorDefinition" errorRef="OperationError" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_1" name="" sourceRef="Drift" targetRef="Incident" />
    <bpmn:sequenceFlow id="Flow_2" name="" sourceRef="Incident" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_3" name="" sourceRef="Prepare" targetRef="Label" />
    <bpmn:sequenceFlow id="Flow_4" name="" sourceRef="Label" targetRef="DataOK" />
    <bpmn:sequenceFlow id="Flow_5" name="Да" sourceRef="DataOK" targetRef="Train">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">data_approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_19" name="Нет" sourceRef="DataOK" targetRef="NoRelease" />
    <bpmn:sequenceFlow id="Flow_6" name="" sourceRef="Train" targetRef="Tune" />
    <bpmn:sequenceFlow id="Flow_7" name="" sourceRef="Tune" targetRef="Validate" />
    <bpmn:sequenceFlow id="Flow_8" name="" sourceRef="Validate" targetRef="ValidationOK" />
    <bpmn:sequenceFlow id="Flow_9" name="Да" sourceRef="ValidationOK" targetRef="Auction">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">validation_approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" name="Нет" sourceRef="ValidationOK" targetRef="NoRelease" />
    <bpmn:sequenceFlow id="Flow_10" name="" sourceRef="Auction" targetRef="Winner" />
    <bpmn:sequenceFlow id="Flow_11" name="Да" sourceRef="Winner" targetRef="Release">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">candidate_auc &gt; champion_auc + auc_margin and guardrails_pass</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_22" name="Нет / равенство" sourceRef="Winner" targetRef="NoRelease" />
    <bpmn:sequenceFlow id="Flow_12" name="" sourceRef="Release" targetRef="ReleaseOK" />
    <bpmn:sequenceFlow id="Flow_13" name="Да" sourceRef="ReleaseOK" targetRef="Deploy">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">release_approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_23" name="Нет" sourceRef="ReleaseOK" targetRef="NoRelease" />
    <bpmn:sequenceFlow id="Flow_14" name="" sourceRef="Deploy" targetRef="Smoke" />
    <bpmn:sequenceFlow id="Flow_15" name="" sourceRef="Smoke" targetRef="Healthy" />
    <bpmn:sequenceFlow id="Flow_16" name="Да" sourceRef="Healthy" targetRef="Outcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">smoke_passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" name="Нет" sourceRef="Healthy" targetRef="Rollback" />
    <bpmn:sequenceFlow id="Flow_20" name="Ошибка" sourceRef="TrainingError" targetRef="NoRelease" />
    <bpmn:sequenceFlow id="Flow_24" name="" sourceRef="NoRelease" targetRef="Retain" />
    <bpmn:sequenceFlow id="Flow_25" name="champion сохранён" sourceRef="Retain" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_27" name="Ошибка" sourceRef="DeployError" targetRef="Rollback" />
    <bpmn:sequenceFlow id="Flow_28" name="Откат проверен" sourceRef="Rollback" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_29" name="Нужен человек" sourceRef="RollbackError" targetRef="Recovery" />
    <bpmn:sequenceFlow id="Flow_30" name="Статус подтверждён" sourceRef="Recovery" targetRef="Outcome" />
    <bpmn:sequenceFlow id="Flow_17" name="" sourceRef="Outcome" targetRef="Notify" />
    <bpmn:sequenceFlow id="Flow_18" name="" sourceRef="Notify" targetRef="End" />
    <bpmn:sequenceFlow id="Flow_31" name="Доставка не удалась" sourceRef="NotifyError" targetRef="LogNotify" />
    <bpmn:sequenceFlow id="Flow_32" name="" sourceRef="LogNotify" targetRef="EndNotify" />
  </bpmn:process>
